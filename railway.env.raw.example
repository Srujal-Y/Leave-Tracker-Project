# =========================
# Railway Raw Variables
# Paste these in Railway -> Service -> Variables (Raw Editor)
# =========================

# --- Core Django ---
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=0
ALLOWED_HOSTS=.up.railway.app,your-domain.com
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://your-domain.com

# --- Database (Railway PostgreSQL/Neon/etc) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Static/Media behavior ---
SERVE_MEDIA=1
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# --- OTP / Email (SMTP Gmail example) ---
OTP_PROVIDER=smtp
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15
EMAIL_FAIL_SILENTLY=0
DEFAULT_FROM_EMAIL=hr@yourcompany.com
OTP_FROM_EMAIL=hr@yourcompany.com

# --- Optional Resend API provider for OTP ---
# OTP_PROVIDER=resend
# RESEND_API_KEY=re_xxx
# RESEND_API_URL=https://api.resend.com/emails

# --- Optional leave notifications ---
EMAIL_NOTIFY_ON_LEAVE=1
HR_NOTIFICATION_EMAILS=hr@yourcompany.com,team@yourcompany.com

# --- Role helper emails (optional) ---
MANAGER_EMAILS=manager1@yourcompany.com,manager2@yourcompany.com

# --- S3 / Cloudflare R2 profile-photo storage (optional, recommended for production) ---
# If you set these, django-storages will be used for profile photos.
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=
# AWS_S3_ADDRESSING_STYLE=path
# AWS_S3_SIGNATURE_VERSION=s3v4
AWS_STORAGE_BUCKET_NAME=your-bucket
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4

# --- Optional explicit app naming in templates ---
PORTAL_APP_NAME=Leave Tracker
